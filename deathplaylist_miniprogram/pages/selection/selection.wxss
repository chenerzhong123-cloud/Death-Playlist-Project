.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #000;
}

/* Header */
.header {
  padding: 32rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.intro-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.intro-text {  display: flex;
  align-items: center;
  gap: 8rpx;
}

.intro-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  font-style: italic;
}

.shuffle-icon {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
}

.intro-edit {
  margin-top: 4rpx;
  width: 100%;
}

.intro-input {
  width: 100%;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.2);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #fff;
  font-style: italic;
  box-sizing: border-box;
  text-align: center;
}

/* Slot List */
.slot-list {
  flex: 1;
  min-height: 0;
}

.song-slot {
  display: flex;
  align-items: center;
  padding: 10rpx 32rpx;
  margin-bottom: 4rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

/* Empty Slot */
.song-slot.empty {
  justify-content: center;
  border: 1rpx dashed rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.02);
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.slot-empty-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 1rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.slot-hint {
  font-size: 26rpx;
  color: #fff;
}

/* Filled Slot */
.song-slot.filled {
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
  transition: transform 0.15s ease;
}

.song-slot.filled:last-of-type {
  border-bottom: none;
}

.song-slot.dragging-item {
  transition: none;
  opacity: 0.85;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.5);
  z-index: 100;
}

/* Max Hint */
.max-hint {
  text-align: center;
  padding: 16rpx 32rpx 24rpx;
}

.max-hint-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.15);
}

.slot-art {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #27272a;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.slot-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.slot-title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-artist {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-grip {
  width: 48rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.grip-icon {
  color: rgba(255,255,255,0.2);
  font-size: 28rpx;
}

.slot-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.remove-icon {
  color: rgba(255,255,255,0.3);
  font-size: 24rpx;
}

/* Bottom Bar */
.bottom-bar {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.btn-next {
  width: 100%;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.3);
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  line-height: 1;
}

.btn-next.active {
  background: #fff;
  color: #000;
}

.btn-next::after { border: none; }
