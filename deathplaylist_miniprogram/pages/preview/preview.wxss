.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: rgba(0,0,0,0.6);
}

.content {
  flex: 1;
  padding: 32rpx 0 200rpx;
}

/* Header */
.header {
  text-align: center;
  margin-bottom: 48rpx;
  padding: 0 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  font-style: italic;
  display: block;
  margin-bottom: 24rpx;
}

.intro-edit {
  width: 100%;
  max-width: 500rpx;
  margin: 0 auto;
}

.intro-input {
  text-align: center;
  background: rgba(255,255,255,0.1);
  border-bottom: 2rpx solid rgba(255,255,255,0.3);
  padding: 16rpx;
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
}

.intro-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx;
}

.intro-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  font-style: italic;
}

.edit-icon {
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
}

/* List Hint */
.list-hint {
  display: flex;
  justify-content: flex-end;
  padding: 0 32rpx;
  margin-bottom: 8rpx;
}

.hint-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

/* Song List */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 16rpx 16rpx;
  gap: 12rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: background 0.15s;
  position: relative;
}

.song-item-dragging {
  background: rgba(255,255,255,0.08);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.5);
  opacity: 0.9;
}

/* Drag Handle */
.drag-handle {
  width: 56rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drag-icon {
  font-size: 36rpx;
  color: rgba(255,255,255,0.15);
  font-weight: bold;
  letter-spacing: -4rpx;
}

.album-art {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #27272a;
  flex-shrink: 0;
}

.song-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.song-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-artist {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Footer */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #000, transparent);
}

.btn-back {
  flex: 1;
  background: rgba(255,255,255,0.1);
  border: 2rpx solid rgba(255,255,255,0.2);
  color: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  font-weight: bold;
  font-size: 30rpx;
  line-height: 1;
}

.btn-back::after { border: none; }

.btn-share {
  flex: 1;
  background: #fff;
  color: #000;
  border-radius: 32rpx;
  padding: 32rpx;
  font-weight: bold;
  font-size: 30rpx;
  border: none;
  line-height: 1;
}

.btn-share::after { border: none; }
