<view class="page-container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-arrow">←</text>
    </view>
    <text class="header-title">歌单详情</text>
  </view>

  <block wx:if="{{playlist}}">
    <view class="card">
      <view class="card-header">
        <image wx:if="{{playlist.user.avatar}}" class="avatar" src="{{playlist.user.avatar}}" />
        <view class="user-info">
          <text class="user-name">{{userName}}的死亡歌单</text>
          <text class="intro">"{{playlist.intro || '暂无简介'}}"</text>
        </view>
      </view>

      <view class="song-list">
        <view class="song-item" wx:for="{{playlist.songs}}" wx:key="id">
          <text class="song-index">{{index + 1}}</text>
          <image class="song-cover" src="{{item.albumArt}}" />
          <view class="song-info">
            <text class="song-title">{{item.title}}</text>
            <text class="song-artist">{{item.artist}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <text class="empty-text">加载中...</text>
  </view>
</view>
