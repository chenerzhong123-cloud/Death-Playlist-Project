.page-container {
  min-height: 100vh;
  background: #000;
  color: #fff;
  padding-bottom: 60rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
  position: sticky;
  top: 0;
  background: rgba(0,0,0,0.8);
  backdrop-filter: blur(20px);
  z-index: 10;
}

.back-btn {
  padding: 10rpx;
  margin-right: 20rpx;
}

.back-arrow {
  font-size: 36rpx;
  color: rgba(255,255,255,0.6);
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
}

.card {
  margin: 30rpx;
  padding: 40rpx;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 48rpx;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

.intro {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  font-style: italic;
  margin-top: 8rpx;
}

.song-list {
  margin-top: 20rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.song-item:last-child {
  border-bottom: none;
}

.song-index {
  width: 40rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.2);
  text-align: center;
  margin-right: 16rpx;
}

.song-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #333;
  margin-right: 20rpx;
}

.song-info {
  flex: 1;
  min-width: 0;
}

.song-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-artist {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.empty-text {
  color: rgba(255,255,255,0.2);
  font-size: 28rpx;
}
