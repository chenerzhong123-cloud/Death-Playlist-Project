.landing {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.landing-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #000;
  z-index: 0;
}

.light-beam {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 95% 2%, rgba(255,255,255,0.25) 0%, transparent 27%),
    conic-gradient(
      from 180deg at 100% 0%,
      transparent 0deg,
      rgba(255,255,255,0.02) 8deg,
      rgba(255,255,255,0.08) 16deg,
      rgba(255,255,255,0.16) 21deg,
      rgba(255,255,255,0.2) 26deg,
      rgba(255,255,255,0.22) 30deg,
      rgba(255,255,255,0.2) 34deg,
      rgba(255,255,255,0.16) 39deg,
      rgba(255,255,255,0.08) 46deg,
      rgba(255,255,255,0.02) 52deg,
      transparent 57deg
    );
}

.landing-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.icon-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 72rpx;
  font-weight: bold;
  font-style: italic;
  letter-spacing: -2rpx;
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: 30rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 300;
  line-height: 1.6;
}

.buttons {
  width: 100%;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  width: 100%;
  background: #fff;
  color: #000;
  border-radius: 32rpx;
  padding: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.btn-primary::after { border: none; }

.btn-secondary {
  width: 100%;
  background: rgba(255,255,255,0.1);
  color: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255,255,255,0.2);
  line-height: 1;
}

.btn-secondary::after { border: none; }
