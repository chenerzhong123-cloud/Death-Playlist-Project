.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #000;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

/* Loading */
.loading-text {
  text-align: center;
  color: rgba(255,255,255,0.3);
  padding: 96rpx 0;
  font-size: 28rpx;
}

/* Playlist Card */
.playlist-card {
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 48rpx;
  padding: 40rpx;
  margin-bottom: 48rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.card-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  flex-shrink: 0;
}

.demo-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.5);
  font-size: 36rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.card-user-info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-user-name {
  font-size: 32rpx;
  font-weight: bold;
}

.mine-badge {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  font-weight: normal;
}

.card-intro {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  font-style: italic;
  margin-top: 4rpx;
}

/* Song rows in card */
.card-songs {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.song-row, .demo-song {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(0,0,0,0.4);
  padding: 20rpx;
  border-radius: 24rpx;
}

.song-album-art {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.demo-album-art {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.song-info, .demo-song-info {
  flex: 1;
  min-width: 0;
}

.song-title, .demo-song-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-artist, .demo-song-artist {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Login CTA */
.login-cta {
  text-align: center;
  padding: 32rpx 0;
}

.cta-text {
  display: block;
  color: rgba(255,255,255,0.3);
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.cta-btn {
  display: inline-flex;
  background: #fff;
  color: #000;
  border-radius: 32rpx;
  padding: 24rpx 64rpx;
  font-weight: bold;
  font-size: 30rpx;
  border: none;
  line-height: 1;
}

.cta-btn::after { border: none; }

/* Empty state */
.empty-state {
  text-align: center;
  padding: 96rpx 0;
}

.empty-text {
  display: block;
  color: rgba(255,255,255,0.5);
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  display: block;
  color: rgba(255,255,255,0.3);
  font-size: 24rpx;
}
