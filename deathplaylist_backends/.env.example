# Environment
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=death-playlist-jwt-secret-change-in-production

# Database
DB_TYPE=better-sqlite3
DB_DATABASE=death_playlist.db

# WeChat
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://www.deuce.monster

# Public app URL (include the nginx subpath and trailing slash)
PUBLIC_BASE_URL=https://www.deuce.monster/deathplaylist/
# Use trial/develop only when testing a corresponding mini program build
WECHAT_CODE_ENV=release
